{
  "version": 1,
  "name": "Person detected, snapshot to notifier",
  "description": "When a person is detected, captures a fresh snapshot and sends it to the selected notification targets, e.g. push devices, email (SMTP plugin) or a messenger provided by a notifier plugin.",
  "inputs": [
    { "key": "camera", "type": "camera", "label": "Camera to watch" },
    { "key": "detector", "type": "plugin", "interface": "ObjectDetection", "label": "Object detection plugin" },
    { "key": "notify", "type": "notification-targets", "label": "Who to notify", "multiple": true }
  ],
  "nodes": [
    {
      "id": "trigger-1",
      "type": "trigger-detection",
      "position": { "x": 0, "y": 0 },
      "data": {
        "type": "trigger-detection",
        "cameraId": "{{input:camera}}",
        "eventPhase": ["start"],
        "detectionLabels": ["person"],
        "confidenceThreshold": 0.6,
        "audioLabels": [],
        "faceFilter": [],
        "licensePlateFilter": []
      }
    },
    {
      "id": "action-1",
      "type": "action-snapshot",
      "position": { "x": 320, "y": 0 },
      "data": {
        "type": "action-snapshot",
        "cameraId": "{{input:camera}}",
        "forceNew": true
      }
    },
    {
      "id": "action-2",
      "type": "action-notification",
      "position": { "x": 640, "y": 0 },
      "data": {
        "type": "action-notification",
        "title": "Person detected",
        "body": "A person was detected on the camera.",
        "severity": "warn",
        "deepLink": "",
        "targets": ["{{input:notify}}"],
        "image": "{{snapshot.base64}}"
      }
    }
  ],
  "edges": [
    {
      "id": "edge-1",
      "source": "trigger-1",
      "target": "action-1",
      "sourceHandle": "source",
      "targetHandle": "target"
    },
    {
      "id": "edge-2",
      "source": "action-1",
      "target": "action-2",
      "sourceHandle": "source",
      "targetHandle": "target"
    }
  ]
}
