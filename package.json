{
  "name": "@camera.ui/automations",
  "version": "0.0.0",
  "private": true,
  "description": "camera.ui community automations store (blueprints + catalog)",
  "type": "module",
  "scripts": {
    "catalog": "tsx ./scripts/catalog.ts",
    "update": "updates -M npm,pypi,go,cargo,docker -u",
    "install-updates": "npm i --save",
    "audit": "npm audit fix --min-release-age=0"
  },
  "homepage": "https://github.com/cameraui/automations#readme",
  "bugs": {
    "url": "https://github.com/cameraui/automations/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cameraui/automations.git"
  },
  "license": "MIT",
  "author": "seydx",
  "devDependencies": {
    "@types/node": "^26.1.0",
    "chalk": "^5.6.2",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "updates": "^20.0.1",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
